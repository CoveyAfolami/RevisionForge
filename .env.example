# Copy this file to .env and fill in your values. NEVER commit .env.

# ---- LLM (pick ONE provider) ----
# Groq is free, no credit card: create a key at https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key
# Alternatives (uncomment the one you use):
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-key
# Optional: override the model (each provider has a sensible default)
# LLM_MODEL=llama-3.3-70b-versatile

# ---- AnkiConnect ----
# When Revision Forge runs on YOUR machine (next to Anki), use localhost:
ANKI_CONNECT_URL=http://localhost:8765
ANKI_CONNECT_KEY=your-ankiconnect-key
