# ============================================================
# AI GCSE Revision Agent - Project-specific .gitignore
# ============================================================


# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*$py.class

# Python build/package artifacts
build/
dist/
*.egg-info/
.eggs/

# Python test/tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/


# ============================================================
# Virtual environments
# ============================================================

.venv/
venv/
env/
ENV/
.env/


# ============================================================
# Environment variables / secrets
# ============================================================

.env
.env.local
.env.*.local

# Local secret/configuration files
*.secret
*.secrets
secrets/
.local/

# Allow the safe configuration template
!.env.example


# ============================================================
# Logs
# ============================================================

*.log
logs/

# Application/runtime logs
runtime_logs/
data/logs/


# ============================================================
# SQLite / runtime databases
# ============================================================

*.db
*.sqlite
*.sqlite3

# SQLite temporary/journal files
*.db-journal
*.sqlite-journal
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Local database directories
data/database/
data/db/

# Test/runtime databases
tests/.database/
tests/test.db
tests/test.sqlite
tests/test.sqlite3


# ============================================================
# AI-agent runtime state
# ============================================================

# Agent state/checkpoints
.agent_state/
agent_state/
runtime_state/
state/

# Temporary/intermediate agent outputs
agent_runtime/
agent_output/
runtime/
tmp/
temp/

# Model/API caches
model_cache/
model_cache/
llm_cache/
api_cache/

# Generated tool/API responses
data/api_responses/
data/web_cache/


# ============================================================
# Project-generated data
# ============================================================

# Runtime resource-processing directories
data/incoming/*
data/processed/*
data/failed/*
data/extracted/*
data/ocr/*
data/downloads/*
data/cache/*
data/tmp/*
data/generated/*

# Automation/watch-folder state
data/watch/*
data/automation/*

# Generated flashcard/output files
data/flashcards/
data/outputs/

# Generated processing history/export files
data/history/
data/processing_history/


# ============================================================
# Preserve project data directory structure
# ============================================================

# Keep the directory structure in Git where useful
!data/incoming/.gitkeep
!data/processed/.gitkeep
!data/failed/.gitkeep
!data/extracted/.gitkeep
!data/ocr/.gitkeep
!data/downloads/.gitkeep
!data/cache/.gitkeep
!data/generated/.gitkeep


# ============================================================
# Study resources
# ============================================================

# User-provided textbooks/resources should remain outside Git
data/raw/*
data/resources/*

# Allow deliberately committed small test fixtures
!tests/fixtures/
!tests/fixtures/**

# Never accidentally commit common large study-resource formats
# from runtime resource directories
data/incoming/**/*.pdf
data/processed/**/*.pdf
data/raw/**/*.pdf
data/resources/**/*.pdf


# ============================================================
# Generated research / AI outputs
# ============================================================

# Generated research results
research_output/
research_results/
data/research/
data/research_cache/

# Generated AI responses/intermediate results
data/ai_output/
data/intermediate/

# Embeddings / vector indexes / search indexes
embeddings/
data/embeddings/
vector_store/
vector_db/
data/vector_store/
indexes/
data/indexes/


# ============================================================
# Anki / AnkiConnect local data
# ============================================================

# Exported/generated Anki decks
*.apkg
*.colpkg

# Generated Anki exchange/export files
data/anki/
data/anki_exports/
anki_exports/

# Local Anki test/output data
tests/anki_data/
tests/anki_exports/

# Local AnkiConnect/runtime configuration
anki.local.*
anki.local.json


# ============================================================
# Development configuration that may contain local paths
# ============================================================

# Local-only configuration
config/local.*
config/*.local.*
config/*local*.json

# Do NOT ignore normal project configuration such as:
# config/settings.json
# config/subjects.json
# unless they contain secrets.


# ============================================================
# IDEs
# ============================================================

# JetBrains
.idea/

# VS Code:
# Ignore machine-specific VS Code state by default.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# If any of the above contain machine-specific paths or secrets,
# remove them from Git and add them back to the ignore rules.


# ============================================================
# Operating system files
# ============================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~


# ============================================================
# Coverage / profiling / debugging
# ============================================================

*.prof
*.lprof
.pytype/
coverage.xml
nosetests.xml
*.cover
*.py,cover


# ============================================================
# Temporary files
# ============================================================

*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig
*.rej

# Editor backup files
*~
~$*


# ============================================================
# OS/application generated archives
# ============================================================

*.crdownload
*.part


# ============================================================
# Docker / deployment local state
# ============================================================

# Ignore local Docker environment files if Docker is introduced
docker-compose.override.yml

# Do NOT ignore:
# Dockerfile
# docker-compose.yml
# deployment configuration
# CI/CD configuration
# because these are project configuration and should normally be
# version controlled.


# ============================================================
# Local automation state
# ============================================================

watch_state.json
automation_state.json
.processing_state
.last_run


# ============================================================
# Local test artifacts
# ============================================================

test_output/
test_results/
e2e_output/
pytest-report/
playwright-report/


# ============================================================
# Generated evaluation artifacts
# ============================================================

evaluation_output/
evaluation_results/
data/evaluation_output/

# Keep deliberately version-controlled evaluation datasets/fixtures
# under tests/fixtures/ or a dedicated version-controlled directory.


# ============================================================
# Local machine metadata
# ============================================================

*.machine.json
*.machine.yaml
*.machine.yml
